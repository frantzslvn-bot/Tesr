# Copie ce fichier en .env pour le dev local (ne le mets jamais sur GitHub)
PORT=3000

# Code de l'espace admin (3 appuis sur le logo). Choisis un code long.
ADMIN_CODE=change-moi

# Fichier de sauvegarde des Coins et des comptes
# En local : data/db.json. Sur Render avec un disque : /var/data/db.json
DATA_FILE=data/db.json

# Sauvegarde GitHub (obligatoire sur Render gratuit, sinon les Coins sont perdus au redémarrage)
# Dépôt PRIVÉ uniquement : db.json contient les jetons de connexion des joueurs.
GITHUB_TOKEN=
BACKUP_REPO=compte/depot-prive
BACKUP_BRANCH=main
BACKUP_INTERVAL_MIN=3
